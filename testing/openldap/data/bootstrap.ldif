##########################
# Agents and OTOBO admin #
##########################

# example OU of the agents
dn: ou=devops,{{ LDAP_BASE_DN }}
changetype: add
objectClass: organizationalUnit
ou: devops

# example admin user
dn: cn=testadmin,ou=devops,{{ LDAP_BASE_DN }}
changetype: add
objectClass: inetOrgPerson
givenName: Admin
cn: testadmin
sn: TestAdmin
uid: testadmin
mail: testadmin@{{ LDAP_DOMAIN }}
preferredLanguage: en
userPassword: testadmin

# example agent user otobotestuser1
dn: cn=otobotestuser1,ou=devops,{{ LDAP_BASE_DN }}
changetype: add
objectClass: inetOrgPerson
givenName: User
cn: otobotestuser1
sn: TestAgent 1
uid: otobotestuser1
mail: mail.testuser1@{{ LDAP_DOMAIN }}
preferredLanguage: de
userPassword: otobotestuser1

# example agent user otobotestuser2
dn: cn=otobotestuser2,ou=devops,{{ LDAP_BASE_DN }}
changetype: add
objectClass: inetOrgPerson
givenName: User
cn: otobotestuser2
sn: TestAgent 2
uid: otobotestuser2
mail: mail.testuser2@{{ LDAP_DOMAIN }}
preferredLanguage: de
userPassword: otobotestuser2

# example admins LDAP group
dn: cn=admins,{{ LDAP_BASE_DN }}
changetype: add
objectClass: top
objectClass: groupOfNames
cn: admins
description: admin team
member: cn=testadmin,ou=devops,{{ LDAP_BASE_DN }}

# example agents LDAP group
dn: cn=agents,{{ LDAP_BASE_DN }}
changetype: add
objectClass: top
objectClass: groupOfNames
cn: agents
description: agent team
member: cn=otobotestuser1,ou=devops,{{ LDAP_BASE_DN }}
member: cn=otobotestuser2,ou=devops,{{ LDAP_BASE_DN }}
member: cn=testadmin,ou=devops,{{ LDAP_BASE_DN }}

##########################
# Customer Users         #
##########################

# example OU of the customer users, tenants of buildings in the peacock garden
dn: ou=tenants,{{ LDAP_BASE_DN }}
changetype: add
objectClass: organizationalUnit
ou: tenants

# example customer user, tenant of the keepers cabin in the peacock garden
dn: cn=keeperscabin,ou=tenants,{{ LDAP_BASE_DN }}
changetype: add
objectClass: inetOrgPerson
givenName: Holger
cn: keeperscabin
sn: Heger
uid: keeperscabin
mail: keeperscabin.peacockgarden@{{ LDAP_DOMAIN }}
preferredLanguage: ca
userPassword: keeperscabin

# example customer user, tenant of the mansion in the peacock garden
dn: cn=mansion,ou=tenants,{{ LDAP_BASE_DN }}
changetype: add
objectClass: inetOrgPerson
givenName: Monika
cn: mansion
sn: Millikan
uid: mansion
mail: mansion.peacockgarden@{{ LDAP_DOMAIN }}
preferredLanguage: ca
userPassword: mansion

# example customer users LDAP group
dn: cn=peacockgarden,{{ LDAP_BASE_DN }}
changetype: add
objectClass: top
objectClass: groupOfNames
cn: peacockgarden
description: Tenants of the Peacock Garden in the Seaside District
member: cn=keeperscabin,ou=tenants,{{ LDAP_BASE_DN }}
member: cn=mansion,ou=tenants,{{ LDAP_BASE_DN }}
